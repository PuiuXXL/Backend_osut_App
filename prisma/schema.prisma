generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  ADMIN
}

enum MembershipRole {
  INACTIVE_VOLUNTEER
  VOLUNTEER
  MEMBER
  ACTIVE_MEMBER
  CO_COORDINATOR
  COORDINATOR
}

enum ProfileRole {
  INACTIVE_VOLUNTEER
  VOLUNTEER
  MEMBER
  ACTIVE_MEMBER
}

model User {
  id                    String         @id
  email                 String         @unique
  emailVerified         Boolean        @default(false)
  displayName           String
  firstName             String?
  lastName              String?
  image                 String?
  systemRole            SystemRole     @default(USER)
  profileRole           ProfileRole    @default(INACTIVE_VOLUNTEER)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  memberships           Membership[]
  announcementsAuthored Announcement[]
  accounts              Account[]
  sessions              Session[]
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String
  imageUrl      String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  announcements Announcement[]
}

model Membership {
  id           String         @id @default(uuid())
  userId       String
  departmentId String
  role         MembershipRole
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model Announcement {
  id           String      @id @default(uuid())
  title        String
  description  String
  imageUrl     String?
  authorId     String
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  author       User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
